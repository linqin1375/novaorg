<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>io.github.tangbailin</groupId>
  <artifactId>novaorg</artifactId>
  <version>1.0.0</version>
  <name>NovaOrg</name>
  <description>Enterprise multi-agent collaboration runtime organized like a company org chart</description>

  <properties>
    <java.version>17</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!--
      Spring AI is deliberately NOT a runtime dependency.

      The project talks to models through its own LlmPort / EmbeddingPort ports, which keeps the
      orchestration, permission, audit and SLA layers testable without a provider client and lets
      the app boot with zero credentials. Dropping Spring AI's ChatClient in behind LlmPort is a
      one-class adapter - docs/ARCHITECTURE.md section 2.6 shows the adapter, and the BOM below is
      kept so adding it later is a single uncommented dependency + the version property.
    -->
    <spring-ai.version>1.1.8</spring-ai.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-mysql</artifactId></dependency>
    <dependency><groupId>com.mysql</groupId><artifactId>mysql-connector-j</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>org.springframework.security</groupId><artifactId>spring-security-test</artifactId><scope>test</scope></dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--
      Spring AI is deliberately NOT a default dependency, and the adapter that uses it
      (io.github.tangbailin.novaorg.llm.SpringAiLlmAdapter) is NOT in src/main/java.

      Reason, learned the hard way while adding it: putting spring-ai-starter-model-openai on the
      default classpath - even as <optional>true</optional>, which still reaches this module's own
      runtime and test classpath - makes Spring AI's OpenAI auto-configuration active in the
      default build. It then demands an API key (`OpenAI API key must be set`) from
      OpenAiAudioSpeechAutoConfiguration and friends, which destroys the project's headline
      property: clone it and it runs with zero credentials.

      So the adapter lives in the `springai` source root and only exists when the Maven profile
      below is active. See docs/ARCHITECTURE.md section 2.6 for the exact commands.
    -->

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <repositories>
    <repository>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
    </repository>
  </repositories>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-Djdk.attach.allowAttachSelf=true -Dfile.encoding=UTF-8</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      mvn -Pspringai ...

      Adds Spring AI *and* the source root that holds the adapter. Neither half exists in the
      default build, so the default classpath stays free of Spring AI and the OpenAI
      auto-configuration can never ask for an API key that the demo mode is not supposed to need.

        src/springai/java      -> SpringAiLlmAdapter (and nothing else)
        src/springai/test/java -> the adapter's own tests (stubbed ChatModel, no key, no network)

      This is deliberately a *capability* switch, not a *mode* switch: it does not flip
      novaorg.llm.mode to live and it does not switch the LlmPort wiring. The adapter only takes
      over when novaorg.llm.springai.enabled=true is set, which is what keeps
      `mvn -Pspringai test` runnable with no credentials.
    -->
    <profile>
      <id>springai</id>
      <dependencies>
        <dependency>
          <groupId>org.springframework.ai</groupId>
          <artifactId>spring-ai-starter-model-openai</artifactId>
          <version>${spring-ai.version}</version>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.1</version>
            <executions>
              <!--
                Two separate executions on purpose: add-source only understands <sources> and
                add-test-source only understands <testSources>. Sharing one execution makes Maven
                warn "Parameter 'testSources' is unknown" and silently skip the test source root.
              -->
              <execution>
                <id>add-springai-main-sources</id>
                <phase>generate-sources</phase>
                <goals>
                  <goal>add-source</goal>
                </goals>
                <configuration>
                  <sources>
                    <source>src/springai/java</source>
                  </sources>
                </configuration>
              </execution>
              <execution>
                <id>add-springai-test-sources</id>
                <phase>generate-test-sources</phase>
                <goals>
                  <goal>add-test-source</goal>
                </goals>
                <configuration>
                  <sources>
                    <source>src/springai/test/java</source>
                  </sources>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <!-- lets the adapter tests know the profile is really on -->
                <novaorg.springai.profile.active>true</novaorg.springai.profile.active>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
